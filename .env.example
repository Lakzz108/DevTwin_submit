NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace_with_your_local_password
NEO4J_DATABASE=neo4j

# Optional local Ollama answer generation. The model is never downloaded by DevTwin.
DEVTWIN_LLM_ENABLED=false
DEVTWIN_LLM_MODEL=qwen3.5:2b
DEVTWIN_LLM_BASE_URL=http://127.0.0.1:11434
DEVTWIN_LLM_TIMEOUT_SECONDS=600
